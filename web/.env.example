# ============================================================================
# Cheatjob — environment variables
# ----------------------------------------------------------------------------
# Copy to `.env` (Next.js loads it automatically), then fill in the values:
#     cp .env.example .env
#
# NEXT_PUBLIC_* vars are exposed to the browser — safe for keys meant to be
# public. Everything else is SERVER-ONLY; never prefix a secret with NEXT_PUBLIC_.
# For production, add the same vars in Vercel: `vercel env add <NAME> production`.
# ============================================================================

# --- Supabase — REQUIRED -----------------------------------------------------
# Dashboard → Project Settings → API.
# Anon key is client-safe; the service role key bypasses RLS — treat it like a
# root password (server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter — REQUIRED (AI drafts + CV extraction) -----------------------
# https://openrouter.ai/keys   (server-only)
OPENROUTER_API_KEY=

# --- Findymail — REQUIRED (recruiter email finder) ---------------------------
# https://app.findymail.com → Settings → API   (server-only, pay-per-lookup)
FINDYMAIL_API_KEY=

# --- Resend — REQUIRED for email (transactional + marketing) -----------------
# https://resend.com/api-keys   (server-only)
# The sending domain (cheatjob.com) must be verified in Resend before mail
# actually delivers.
RESEND_API_KEY=
# Optional — override the default from-addresses (defined in code otherwise):
# EMAIL_FROM_TRANSACTIONAL="Cheatjob <notifications@cheatjob.com>"
# EMAIL_FROM_LIFECYCLE="Cheatjob <bonjour@cheatjob.com>"

# --- Cron — REQUIRED in production -------------------------------------------
# Secures the scheduled-email job. Any long random string —
# generate one with: openssl rand -base64 32
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- App URL — optional (server-only) ----------------------------------------
# Canonical origin for links inside transactional emails. Defaults to
# https://www.cheatjob.com when unset. No NEXT_PUBLIC_ prefix: server-only.
SITE_URL=https://www.cheatjob.com

# --- PostHog — optional (analytics; leave empty to disable) ------------------
# https://eu.posthog.com → Project Settings. Key is client-safe.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Brandfetch — optional (landing trust strip) -----------------------------
# https://developers.brandfetch.com   (server-only).
# Empty → the Receipts ticker falls back to plain company names.
BRANDFETCH_API_KEY=

# --- Stripe — Phase 4 (provision the keys now, wired into checkout later) ----
# https://dashboard.stripe.com → Developers → API keys. Start with TEST keys.
# Publishable key is client-safe; secret + webhook signing secret are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase 0 landing CTAs — hosted Payment Link URLs (https://buy.stripe.com/...).
# Leave empty to show the sign-up CTA on that plan instead.
NEXT_PUBLIC_STRIPE_LINK_SPRINT=
NEXT_PUBLIC_STRIPE_LINK_MOIS=
NEXT_PUBLIC_STRIPE_LINK_VIE=

# --- Blog auto-pipeline (Phase 5) -------------------------------------------
# Fine-grained GitHub PAT with contents:write on AirKyzzZ/cheatjob
GITHUB_TOKEN=
# owner/repo for the Contents API commit target
GITHUB_REPO=AirKyzzZ/cheatjob
# branch to commit posts to (defaults to main if unset)
GITHUB_BRANCH=main
# Vercel Deploy Hook URL, POSTed after each commit to rebuild
VERCEL_DEPLOY_HOOK_URL=

# --- Testing — optional ------------------------------------------------------
# Set to 1 ONLY when running the E2E suite — it makes Findymail / OpenRouter /
# Resend return canned responses instead of hitting real APIs. Never set this
# in dev or production.
# E2E_MOCK=1
